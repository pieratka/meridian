# --- Database ---
# Local dev: a SQLite file in the working dir.
DATABASE_URL=sqlite:///meridian.db
# Production (Fly): SQLite on the mounted volume.
# DATABASE_URL=sqlite:////data/meridian.db
# Or a managed Postgres:
# DATABASE_URL=postgresql://user:password@host:5432/meridiano

# --- AI models (routed through liteLLM: model = provider/modelname) ---
# We use Google Gemini for everything. liteLLM reads GEMINI_API_KEY for any `gemini/...` model.
GEMINI_API_KEY=your_gemini_api_key_here
LLM_CHAT_MODEL=gemini/gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini/gemini-embedding-001
# Note: Gemini API needs billing enabled on the key's project (the free tier is not
# offered in the EEA/UK). Model ids retire over time — list current ones with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"

# --- Alternative providers (optional) ---
# liteLLM lets you swap providers with no code change. Examples:
# DEEPSEEK_API_KEY=...        ; LLM_CHAT_MODEL=deepseek/deepseek-chat
# TOGETHER_AI_API_KEY=...     ; EMBEDDING_MODEL=together_ai/intfloat/multilingual-e5-large-instruct
# Local / offline via Ollama:
# OLLAMA_API_BASE=http://localhost:11434
# LLM_CHAT_MODEL=ollama/qwen3:30b
# EMBEDDING_MODEL=ollama/nomic-embed-text

# --- Flask web UI ---
FLASK_SECRET_KEY=change_me_to_a_long_random_string
FLASK_ENV=development
