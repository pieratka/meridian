# Daily intelligence brief at 09:30 Europe/Paris (TZ set in fly.toml, so DST-proof).
# --all runs every stage in order: scrape -> process (summarize+embed) -> rate -> generate.
# Lookback for the brief is 24h (config_base.BRIEFING_ARTICLE_LOOKBACK_HOURS).
30 9 * * * cd /app && .venv/bin/python -m meridiano.run_briefing --feed default --all
